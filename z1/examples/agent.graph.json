    {
      "id": "d-chat2-output",
      "kind": "data",
      "from": { "node": "chat2", "port": "text" },
      "to": { "node": "output", "port": "value" }
    },
    {
      "id": "f-input-chat1",
      "kind": "flow",
      "from": { "node": "input", "port": "out" },
      "to": { "node": "chat1", "port": "in" }
    },
    {
      "id": "f-chat1-tool1",
      "kind": "flow",
      "from": { "node": "chat1", "port": "out" },
      "to": { "node": "tool1", "port": "in" }
    },
    {
      "id": "f-tool1-chat2",
      "kind": "flow",
      "from": { "node": "tool1", "port": "out" },
      "to": { "node": "chat2", "port": "in" }
    },
    {
      "id": "f-chat2-output",
      "kind": "flow",
      "from": { "node": "chat2", "port": "out" },
      "to": { "node": "output", "port": "in" }
    }
  ]
}
