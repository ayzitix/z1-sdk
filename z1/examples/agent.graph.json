{
  "schemaVersion": 1,
  "id": "agent",
  "title": "Agent loop (mock provider)",
  "nodes": [
    {
      "id": "input",
      "type": "z1.core.input",
      "version": "1.0.0",
      "config": {},
      "position": { "x": 0, "y": 120 }
    },
    {
      "id": "model",
      "type": "z1.llm.model",
      "version": "1.0.0",
      "config": { "provider": "mock", "model": "mock-1" },
      "position": { "x": 0, "y": -80 }
    },
    {
      "id": "chat1",
      "type": "z1.llm.chat",
      "version": "1.0.0",
      "config": {},
      "position": { "x": 280, "y": 0 }
    },
    {
      "id": "tool1",
      "type": "z1.tool.call",
      "version": "1.0.0",
      "config": { "name": "echo" },
      "position": { "x": 560, "y": 0 }
    },
    {
      "id": "chat2",
      "type": "z1.llm.chat",
      "version": "1.0.0",
      "config": {},
      "position": { "x": 840, "y": 0 }
    },
    {
      "id": "done",
      "type": "z1.core.const",
      "version": "1.0.0",
      "config": { "value": "done" },
      "position": { "x": 560, "y": 180 }
    },
    {
      "id": "output",
      "type": "z1.core.output",
      "version": "1.0.0",
      "config": {},
      "position": { "x": 1120, "y": 0 }
    }
  ],
  "edges": [
    {
      "id": "d-input-prompt",
      "kind": "data",
      "from": { "node": "input", "port": "value" },
      "to": { "node": "chat1", "port": "prompt" }
    },
    {
      "id": "d-model-chat1",
      "kind": "data",
      "from": { "node": "model", "port": "model" },
      "to": { "node": "chat1", "port": "model" }
    },
    {
      "id": "d-model-chat2",
      "kind": "data",
      "from": { "node": "model", "port": "model" },
      "to": { "node": "chat2", "port": "model" }
    },
    {
      "id": "d-chat1-tool-args",
      "kind": "data",
      "from": { "node": "chat1", "port": "toolCalls" },
      "to": { "node": "tool1", "port": "args" }
    },
    {
      "id": "d-done-chat2",
      "kind": "data",
      "from": { "node": "done", "port": "value" },
      "to": { "node": "chat2", "port": "prompt" }
