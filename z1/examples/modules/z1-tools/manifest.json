{
  "schemaVersion": 1,
  "id": "com.z1.tools",
  "version": "0.1.0",
  "title": "z1 tools",
  "description": "Filesystem, shell, git and todo tools for z1 workers",
  "author": "z1",
  "license": "MIT",
  "engines": { "z1": ">=0.1.0" },
  "entry": "index.js",
  "nodes": [],
  "services": [{ "id": "tools", "kind": "tools", "mode": "worker" }],
  "capabilities": {
    "fs": { "read": ["/**"], "write": ["/**"] },
    "process": { "spawn": ["*"] }
  },
  "limits": { "timeoutMs": 300000 }
}
